# =============================================
# Usta24 production sozlamalari. "./usta24.sh install" bu faylni deploy/.env ga o'zi yozadi
# (maxfiy kalitlar avtomatik yaratiladi). deploy/.env ni hech kimga bermang va git'ga qo'shmang.
# O'zgartirgandan keyin: ./usta24.sh restart  (DOMAIN o'zgarsa: ./usta24.sh update)
# =============================================

# Sayt domeni (DNS'da A yozuvi shu serverning IP manziliga qarashi kerak) va to'liq manzili
DOMAIN=usta24.uz
PUBLIC_APP_URL=https://usta24.uz
# www.usta24.uz ham ochilsin (asosiy domenga yo'naltiriladi). Avval DNS'ga www A yozuvini qo'shing
# WWW_DOMAIN=www.usta24.uz

# Maxfiy kalitlar: har biri kamida 32 belgili tasodifiy qator (openssl rand -hex 32)
POSTGRES_PASSWORD=
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# Administrator: shu raqam bilan kiriladi, birinchi kirishda ikki bosqichli himoya (2FA) yoqiladi
ADMIN_PHONE=+998901234567
ADMIN_NAME=Administrator
ADMIN_REQUIRE_2FA=true

# Kirish kodi: Eskiz SMS va/yoki Telegram bot (kamida bittasi kerak, aks holda hech kim kira olmaydi)
OTP_DEV_MODE=false
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
TELEGRAM_BOT_TOKEN=

# Yordam sahifasidagi kontaktlar (Telegram - @ belgisisiz username)
SUPPORT_PHONE=
SUPPORT_TELEGRAM=

# Komissiya (ish haqidan, %): tezkor chaqiruv va oddiy (katalog) buyurtma; 0 - olinmaydi
PLATFORM_COMMISSION_PERCENT=10
CATALOG_COMMISSION_PERCENT=10
# Mijoz yakunlagan oddiy buyurtmaning summasini usta shu soat ichida kiritadi
PRICE_ENTRY_HOURS=24
# Komissiya qarzi shu summadan (so'm) oshsa, usta to'lamaguncha ishga chiqa olmaydi (0 - cheklov yo'q)
COMMISSION_DEBT_LIMIT=200000
# Ustalarga ko'rsatiladigan to'lov rekvizitlari, masalan: Uzcard 8600 1234 5678 9012 (Ali Valiyev). Izohga telefon raqamingizni yozing
COMMISSION_PAYMENT_INFO=
DISPATCH_REQUIRE_VERIFIED=true

# Zaxira: har kuni soat nechada (Toshkent vaqti), kunlik va haftalik nusxalar qancha saqlanadi
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8

# Portlar (odatda o'zgartirilmaydi)
# HTTP_PORT=80
# HTTPS_PORT=443
