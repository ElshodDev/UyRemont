PORT=5000
NODE_ENV=development

# PostgreSQL (lokal yoki Supabase)
# Lokal: postgresql://postgres:postgres@localhost:5432/uyremont
# Supabase: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uyremont
# SSL avtomatik aniqlanadi (Supabase/Neon uchun yoqiladi). Majburan: true | false
# DATABASE_SSL=false

# JWT (kamida 32 belgili tasodifiy qator: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend manzili (CORS). Bir nechta bo'lsa vergul bilan
CLIENT_URL=http://localhost:3000

# npm run db:setup ishga tushganda shu raqam administrator qilinadi
ADMIN_PHONE=+998900000000
ADMIN_NAME=Administrator

# Eskiz.uz SMS - real foydalanuvchilar uchun majburiy
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ---------- Xavfsizlik ----------
# Sinov rejimi: kirish kodi ekranda ko'rsatiladi. FAQAT sinov uchun!
# Real foydalanuvchilar bilan false bo'lishi shart (NODE_ENV=production da true bo'lsa server ishga tushmaydi)
OTP_DEV_MODE=true
# Bitta raqamga sutkasiga yuboriladigan kodlar soni (sukut: 10, sinov rejimida 100)
# OTP_DAILY_LIMIT=10
# Administratorlar uchun ikki bosqichli kirish (authenticator ilovasi) majburiy. Productionda: true
ADMIN_REQUIRE_2FA=false
# 2FA kalitlarini bazada shifrlash kaliti (kamida 32 belgili tasodifiy qator). Bo'sh bo'lsa JWT_SECRET ishlatiladi
DATA_ENCRYPTION_KEY=
# Qaysi proksi-serverga ishonish: loopback (sukut), raqam (masalan 1) yoki IP. To'g'ridan-to'g'ri internetda: false
TRUST_PROXY=loopback

# Yuklangan portfolio rasmlari papkasi (ixtiyoriy)
# UPLOAD_DIR=./uploads
# Buyurtma (muammo) rasmlari - ochiq papka emas, faqat ruxsat tekshirilgan API orqali beriladi
# ORDER_PHOTO_DIR=./private_uploads/orders
# Ustalarning tasdiqlash hujjatlari (pasport, selfi, sertifikat) - faqat administratorga beriladi
# MASTER_DOC_DIR=./private_uploads/documents

# Qo'llab-quvvatlash kontaktlari (/support sahifasida ko'rsatiladi). Telegram - @ belgisisiz username
SUPPORT_PHONE=
SUPPORT_TELEGRAM=

# Telegram bot (ixtiyoriy): kirish kodi SMS o'rniga Telegram orqali, ustaga takliflar va mijozga xabarlar.
# Telegram'da @BotFather -> /newbot -> tokenni shu yerga yozing (yoki: npm run setup -- --skip-install --telegram=TOKEN)
TELEGRAM_BOT_TOKEN=
# Xabarlardagi havolalar uchun sayt manzili (masalan https://usta24.uz). Bo'sh bo'lsa CLIENT_URL ishlatiladi
# PUBLIC_APP_URL=
# Production: webhook manzili (bo'sh bo'lsa long polling - bitta server nusxasi uchun)
# TELEGRAM_WEBHOOK_URL=https://api.usta24.uz/api/telegram/webhook

# Komissiya (ish haqidan, %): tezkor chaqiruv va oddiy (katalog) buyurtma. CATALOG berilmasa - PLATFORM bilan bir xil, 0 - olinmaydi
PLATFORM_COMMISSION_PERCENT=10
CATALOG_COMMISSION_PERCENT=10
# Mijoz yakunlagan oddiy buyurtmaning yakuniy summasini usta shu soat ichida kiritadi
PRICE_ENTRY_HOURS=24
# Referal bonuslari (so'm, ustaning komissiya hisobiga): taklif qilgan ustaga / yangi ustaga / mijoz taklif qilgan ustaga
REFERRAL_MASTER_BONUS=20000
REFERRAL_WELCOME_BONUS=20000
REFERRAL_CLIENT_BONUS=5000
# Bonus beriladigan buyurtmaning eng kam ish haqi
REFERRAL_MIN_LABOR=50000
# Tezkor chaqiruv (taxi rejimi) sozlamalari
# Komissiya qarzi shu summadan (so'm) oshsa, usta to'lamaguncha ishga chiqa olmaydi (0 - cheklov yo'q)
COMMISSION_DEBT_LIMIT=200000
# Ustalarga ko'rsatiladigan to'lov rekvizitlari ("Komissiya hisobi" sahifasida)
COMMISSION_PAYMENT_INFO=
DISPATCH_OFFER_TIMEOUT_SEC=20
DISPATCH_SEARCH_TIMEOUT_MIN=5
# false bo'lsa tasdiqlanmagan ustalar ham tezkor buyurtma oladi
DISPATCH_REQUIRE_VERIFIED=true

# Shu millisekunddan uzoq davom etgan so'rovlar logga yoziladi
SLOW_QUERY_MS=1000
