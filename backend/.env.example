PORT=5000
NODE_ENV=development

# PostgreSQL (lokal yoki Supabase)
# Lokal: postgresql://postgres:postgres@localhost:5432/uyremont
# Supabase: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uyremont
# SSL avtomatik aniqlanadi (Supabase/Neon uchun yoqiladi). Majburan: true | false
# DATABASE_SSL=false

# JWT (kamida 32 belgili tasodifiy qator: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend manzili (CORS). Bir nechta bo'lsa vergul bilan
CLIENT_URL=http://localhost:3000

# npm run db:setup ishga tushganda shu raqam administrator qilinadi
ADMIN_PHONE=+998900000000
ADMIN_NAME=Administrator

# Eskiz.uz SMS - real foydalanuvchilar uchun majburiy
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ---------- Xavfsizlik ----------
# Sinov rejimi: kirish kodi ekranda ko'rsatiladi. FAQAT sinov uchun!
# Real foydalanuvchilar bilan false bo'lishi shart (NODE_ENV=production da true bo'lsa server ishga tushmaydi)
OTP_DEV_MODE=true
# Bitta raqamga sutkasiga yuboriladigan kodlar soni (sukut: 10, sinov rejimida 100)
# OTP_DAILY_LIMIT=10
# Administratorlar uchun ikki bosqichli kirish (authenticator ilovasi) majburiy. Productionda: true
ADMIN_REQUIRE_2FA=false
# 2FA kalitlarini bazada shifrlash kaliti (kamida 32 belgili tasodifiy qator). Bo'sh bo'lsa JWT_SECRET ishlatiladi
DATA_ENCRYPTION_KEY=
# Qaysi proksi-serverga ishonish: loopback (sukut), raqam (masalan 1) yoki IP. To'g'ridan-to'g'ri internetda: false
TRUST_PROXY=loopback

# Yuklangan portfolio rasmlari papkasi (ixtiyoriy)
# UPLOAD_DIR=./uploads
# Buyurtma (muammo) rasmlari - ochiq papka emas, faqat ruxsat tekshirilgan API orqali beriladi
# ORDER_PHOTO_DIR=./private_uploads/orders

# Tezkor chaqiruv (taxi rejimi) sozlamalari
PLATFORM_COMMISSION_PERCENT=10
DISPATCH_OFFER_TIMEOUT_SEC=20
DISPATCH_SEARCH_TIMEOUT_MIN=5
# false bo'lsa tasdiqlanmagan ustalar ham tezkor buyurtma oladi
DISPATCH_REQUIRE_VERIFIED=true

# Shu millisekunddan uzoq davom etgan so'rovlar logga yoziladi
SLOW_QUERY_MS=1000
